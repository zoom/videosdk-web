          "type": "boolean",
          "optional": false,
          "description": "Whether the watermark is repeat"
        },
        {
          "name": "position",
          "type": "'top' | 'bottom' | 'left' | 'middle' | 'right'",
          "optional": false,
          "description": "Watermark position"
        }
      ]
    },
    {
      "kind": "interface",
      "type": "ZoomBroadcastStreamingOptions",
      "description": "Options of Zoom Broadcast streaming",
      "properties": [
        {
          "name": "dependentAssets",
          "type": "string",
          "optional": true,
          "description": "Optional.  The Zoom Video SDK uses web workers and web assembly to process the media stream.\n- `Global`: The default value. The dependent assets path will be `https://source.zoom.us/videosdk/{version}/lib/`\n- `CDN`: The dependent assets path will be `https://dmogdx0jrul3u.cloudfront.net/videosdk/{version}/lib/`\n- `CN`: Only applicable for China. The dependent assets path will be https://jssdk.zoomus.cn/videosdk/{version}/lib\n- `{FULL_ASSETS_PATH}`: The SDK will load the dependent assets specified by the developer."
        },
        {
          "name": "alternativeNameForLiveVideo",
          "type": "string",
          "optional": true,
          "description": "Optional. Alternative name for Zoom Live Video to avoid name conflict with any existing web components you may be using."
        },
        {
          "name": "webEndpoint",
          "type": "string",
          "optional": true,
          "description": "Optional. Specifies the web endpoint. The default is zoom.us."
        },
        {
          "name": "watermark",
          "type": "StreamingWatermark",
          "optional": true,
          "description": "Optional. Specifies the watermark."
        },
        {
          "name": "userName",
          "type": "string",
          "optional": true,
          "description": "Optional. Specifies the display name of the viewer in chat. If not specified, a random name is generated."
        }
      ]
    },
